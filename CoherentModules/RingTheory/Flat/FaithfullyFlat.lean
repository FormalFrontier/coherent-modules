module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
public import Mathlib.RingTheory.Finiteness.Ideal
public import Mathlib.RingTheory.Ideal.Over
public import Mathlib.RingTheory.Jacobson.Ideal
public import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# Criteria for faithful flatness

A flat module surjecting onto a faithfully flat module is faithfully flat.
For a unital algebra, faithful flatness can be tested using only finitely
generated proper ideals, together with flatness. The algebra need not be
commutative. The coefficient ring and module carriers may lie in independent
universes.

For arbitrary modules, faithful flatness can also be tested after base change
along a commutative algebra for which every maximal ideal extends to a proper
ideal, while retaining flatness over the original ring. No flatness of the scalar
algebra is required. Scalar extension uses the canonical left tensor-factor action.
Quotienting by an ideal contained in the Jacobson radical gives a module criterion
and, for commutative algebras, a canonical quotient-algebra criterion.

## Proof approach

Mapping an equality `I • ⊤ = ⊤` along the surjection gives the same equality
in the target. The target's faithful flatness forces `I = ⊤`; combining this
with the source's flatness proves faithful flatness of the source.

For the algebra criterion, a finite linear combination witnessing
`1 ∈ I • ⊤` uses only finitely many coefficients from `I`. The ideal `J`
generated by those coefficients is finitely generated and contained in `I`.
Right multiplication is linear, so `1 ∈ J • ⊤` implies `a ∈ J • ⊤` for
every algebra element `a`. This argument uses the identity but not
commutativity of the algebra.

For the base-change criterion, arbitrary faithfully-flat base change proves the
forward implication. Conversely, if a maximal ideal acts with full image on the
original module, its module quotient vanishes. The quotient-tensor equivalence
then shows that the extended ideal acts with full image on the base-changed
module, contradicting faithful flatness and properness of that extended ideal.
For the Jacobson-ideal specialization, every maximal ideal contains the given
ideal, so its image in the quotient ring is proper. The algebra corollary follows
by the canonical quotient-algebra/tensor equivalence.

## References

The proofs use Mathlib's ideal-smul criteria for faithful flatness,
`Submodule.map_smul''`, `Submodule.map_top`, `LinearMap.range_eq_top`,
`Submodule.mem_ideal_smul_span_iff_exists_sum`, `LinearMap.mulRight` and
`Submodule.smul_top_le_comap_smul_top`.

The base-change criterion additionally uses Mathlib's faithfully-flat base change,
`Submodule.Quotient.subsingleton_iff` and
`TensorProduct.tensorQuotMapSMulEquivTensorQuot`. The Jacobson-ideal specialization
uses `Ideal.IsMaximal.map_of_surjective_of_ker_le`, and the algebra corollary uses
`Algebra.TensorProduct.quotIdealMapEquivQuotTensor`.
The faithfully-flat and quotient-tensor developments are due to Mathlib and its
authors, including Judith Ludwig, Florent Schaffhauser, Yunzhou Xie, Jujian Zhang,
Antoine Chambert-Loir, Christian Merten, Yi Song, Sihan Su, Kim Morrison,
Johan Commelin and Eric Wieser.

* Kazuhiro Fujiwara and Fumiharu Kato, *Foundations of Rigid Geometry I*,
  arXiv:1308.4734v5 (2017-02-28), Lemma 0.7.3.6 and Proposition 0.7.3.2(c).
  The quotient criterion is an algebraic strengthening, not an adic formulation.
-/

@[expose] public section

universe u v w

open scoped TensorProduct

namespace Submodule

private theorem one_mem_ideal_smul_top_iff
    {R : Type u} {A : Type v} [Semiring R] [Semiring A]
    [Module R A] [IsScalarTower R A A] (I : Ideal R) :
    (1 : A) ∈ I • (⊤ : Submodule R A) ↔ I • (⊤ : Submodule R A) = ⊤ := by
  constructor
  · intro h1
    apply top_unique
    intro a _
    simpa only [Submodule.mem_comap, LinearMap.mulRight_apply, one_mul] using
      (Submodule.smul_top_le_comap_smul_top I (LinearMap.mulRight R a) h1)
  · intro h
    rw [h]
    exact Submodule.mem_top

end Submodule

namespace Module.FaithfullyFlat

/-- A flat source module is faithfully flat if it admits a surjective linear map
onto a faithfully flat target module over the same commutative ring. -/
theorem of_surjective
    {R : Type u} {M : Type v} {N : Type w}
    [CommRing R] [AddCommGroup M] [AddCommGroup N] [Module R M] [Module R N]
    [Module.Flat R M] [Module.FaithfullyFlat R N]
    (f : M →ₗ[R] N) (hf : Function.Surjective f) : Module.FaithfullyFlat R M := by
  apply (Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top R M).mpr
  refine ⟨inferInstance, ?_⟩
  intro I hI
  apply ((Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top R N).mp inferInstance).2 I
  simpa only [Submodule.map_smul'', Submodule.map_top,
    LinearMap.range_eq_top.mpr hf] using congrArg (Submodule.map f) hI

/-- A unital algebra is faithfully flat precisely when it is flat and every
finitely generated proper ideal acts with proper image. The algebra need not
be commutative: an ideal acting with full image has a finite subideal whose
image contains the algebra's identity. This criterion is not asserted for
arbitrary modules without an algebra structure. -/
theorem algebra_iff_flat_and_fg_proper_ideal
    (R : Type u) (A : Type v) [CommRing R] [Ring A] [Algebra R A] :
    Module.FaithfullyFlat R A ↔ Module.Flat R A ∧
      ∀ I : Ideal R, I.FG → I ≠ ⊤ → I • (⊤ : Submodule R A) ≠ ⊤ := by
  constructor
  · intro h
    obtain ⟨hflat, hproper⟩ := (iff_flat_and_proper_ideal R A).mp h
    exact ⟨hflat, fun I _ hI => hproper I hI⟩
  · rintro ⟨hflat, hproper⟩
    apply (iff_flat_and_proper_ideal R A).mpr
    refine ⟨hflat, ?_⟩
    intro I hI hIA
    have h1 : (1 : A) ∈ I • (⊤ : Submodule R A) := by
      rw [hIA]
      exact Submodule.mem_top
    obtain ⟨c, hc, hc1⟩ :=
      (Submodule.mem_ideal_smul_span_iff_exists_sum I (id : A → A) 1).mp
        (by simpa only [Set.range_id, Submodule.span_univ] using h1)
    classical
    let J : Ideal R := Ideal.span (↑(c.support.image c) : Set R)
    have hJfg : J.FG := ⟨c.support.image c, rfl⟩
    have hJI : J ≤ I := by
      apply Ideal.span_le.mpr
      intro r hr
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hr
      exact hc a
    have hJ : J ≠ ⊤ := fun hJtop => hI (top_unique (hJtop ▸ hJI))
    apply hproper J hJfg hJ
    apply (Submodule.one_mem_ideal_smul_top_iff J).mp
    rw [← hc1]
    exact Submodule.sum_mem _ fun a ha =>
      Submodule.smul_mem_smul
        (Ideal.subset_span (Finset.mem_image.mpr ⟨a, ha, rfl⟩)) Submodule.mem_top

/-- If every maximal ideal of `R` extends to a proper ideal of `S`, an `R`-module
is faithfully flat precisely when it is flat over `R` and its scalar extension is
faithfully flat over `S`, with the canonical action on the left tensor factor.
The ideal hypothesis says that every closed point of `Spec R` has a point over it
in `Spec S`. No flatness of `S` over `R`, surjectivity of the scalar map, algebra
structure on `M`, or finiteness hypothesis is required. Flatness of the original
module remains a separate necessary condition. -/
theorem iff_flat_and_baseChange_of_map_maximal_ne_top
    {R : Type u} {S : Type v} {M : Type w}
    [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M]
    (hmax : ∀ m : Ideal R, m.IsMaximal →
      m.map (algebraMap R S) ≠ ⊤) :
    Module.FaithfullyFlat R M ↔
      Module.Flat R M ∧ Module.FaithfullyFlat S (S ⊗[R] M) := by
  constructor
  · intro h
    let := h
    exact ⟨inferInstance, inferInstance⟩
  · rintro ⟨hflat, hbase⟩
    refine { toFlat := hflat, submodule_ne_top := ?_ }
    intro m hm htop
    let : Subsingleton (M ⧸ (m • (⊤ : Submodule R M))) :=
      Submodule.Quotient.subsingleton_iff.mpr htop
    have hquot : Subsingleton
        ((S ⊗[R] M) ⧸ m.map (algebraMap R S) • (⊤ : Submodule S (S ⊗[R] M))) :=
      (TensorProduct.tensorQuotMapSMulEquivTensorQuot M S m).injective.subsingleton
    exact ((iff_flat_and_proper_ideal S (S ⊗[R] M)).mp hbase).2
      _ (hmax m hm) (Submodule.Quotient.subsingleton_iff.mp hquot)

/-- A module is faithfully flat precisely when it is flat over the original ring
and its base change modulo an ideal contained in the Jacobson radical is faithfully
flat. The quotient algebra and the action on the left tensor factor are canonical.
No algebra structure on the module or finiteness hypothesis is needed.

This specializes `iff_flat_and_baseChange_of_map_maximal_ne_top`: each maximal
ideal contains `I`, so its image in `R ⧸ I` is proper. Original flatness is
essential: for `R = ℤ/4`, `I = (2)` and `M = ℤ/2`, the base change is faithfully
flat but `M` is not flat over `R`.

For commutative algebras this gives `iff_flat_and_quotient_of_le_jacobson`, an
algebraic strengthening of Fujiwara--Kato, *Foundations of Rigid Geometry I*,
arXiv:1308.4734v5, Lemma 0.7.3.6 using Proposition 0.7.3.2(c). -/
theorem iff_flat_and_baseChange_of_le_jacobson
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    (I : Ideal R) (hI : I ≤ Ideal.jacobson (⊥ : Ideal R)) :
    Module.FaithfullyFlat R M ↔
      Module.Flat R M ∧
        Module.FaithfullyFlat (R ⧸ I) ((R ⧸ I) ⊗[R] M) := by
  refine iff_flat_and_baseChange_of_map_maximal_ne_top (S := R ⧸ I) ?_
  intro m hm
  let := hm
  have hIm : I ≤ m := hI.trans (sInf_le ⟨bot_le, hm⟩)
  have hmmap : (m.map (Ideal.Quotient.mk I)).IsMaximal :=
    Ideal.IsMaximal.map_of_surjective_of_ker_le
      Ideal.Quotient.mk_surjective (by simpa only [Ideal.mk_ker] using hIm)
  simpa only [Ideal.Quotient.algebraMap_eq] using hmmap.ne_top

/-- Faithful flatness can be tested modulo an ideal contained in the Jacobson
radical, provided flatness over the original ring is retained. Both quotients
and the algebra structure on the target quotient are the canonical ones.

This is the commutative-algebra corollary of
`iff_flat_and_baseChange_of_le_jacobson`, transported by Mathlib's canonical
quotient-tensor equivalence. No finite generation or topological hypothesis is needed.

This is an algebraic strengthening of Fujiwara--Kato, *Foundations of Rigid
Geometry I*, arXiv:1308.4734v5, Lemma 0.7.3.6 using Proposition 0.7.3.2(c):
explicit Jacobson containment replaces the adic and Zariskian hypotheses.
Original flatness is essential: for `R = ℤ/4`, `I = (2)` and `S = ℤ/2`,
the quotient algebra is faithfully flat but `S` is not flat over `R`. -/
theorem iff_flat_and_quotient_of_le_jacobson
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (hI : I ≤ Ideal.jacobson (⊥ : Ideal R)) :
    Module.FaithfullyFlat R S ↔
      Module.Flat R S ∧
        Module.FaithfullyFlat (R ⧸ I) (S ⧸ I.map (algebraMap R S)) := by
  refine (iff_flat_and_baseChange_of_le_jacobson I hI).trans
    (and_congr_right fun _ => ?_)
  constructor
  · intro h
    have := h
    exact Module.FaithfullyFlat.of_linearEquiv
      (R ⧸ I) ((R ⧸ I) ⊗[R] S)
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S I).toLinearEquiv
  · intro h
    have := h
    exact Module.FaithfullyFlat.of_linearEquiv
      (R ⧸ I) (S ⧸ I.map (algebraMap R S))
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S I).toLinearEquiv.symm

end Module.FaithfullyFlat
