module

public import CoherentModules.RingTheory.Ideal.AdicCompatibility
public import CoherentModules.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Jacobson.Ideal

/-!
# Krull intersection and finite-generation detection

For an ideal satisfying finite-submodule adic cofinality, an element of a finite
module belongs to every ideal-power multiple exactly when some scalar in the
ideal fixes it. Containment of the ideal in the Jacobson radical of the module's
annihilator therefore makes the intersection zero.

For an arbitrary submodule `N`, the corresponding statements need only finiteness
of the quotient `M ⧸ N`: membership in `⨅ n, N ⊔ I ^ n • ⊤` is characterized by
`(1 - a) • x ∈ N` for some `a ∈ I`. A Jacobson bound relative to the quotient's
annihilator makes this intersection equal to `N`. Neither the ambient module nor
`N` needs to be finite in these quotient statements.

For a submodule `N` of a finite ambient module, a Jacobson bound relative to its
ambient annihilator also detects finite generation on the intrinsic first adic
quotient `N / I N` over the original ring. Finitely many quotient generators lift
to a finite submodule;
iteration and the intersection equality recover `N` itself. No finite-generation
assumption on the ideal is required.

## Implementation notes

The cyclic submodule generated by an element is finitely generated, so stage one
of cofinality and Mathlib's `Submodule.mem_smul_span_singleton` give its fixing
scalar. Relative cancellation uses an inverse of `1 - a` modulo the annihilator,
not a unit of the scalar ring. Quotient transport uses comap, which preserves
infima. All actions are the given actions or the ordinary quotient actions, and
the ring and module universes are independent. These are algebraic results;
no topology or completeness result is asserted here.

## References

* Kazuhiro Fujiwara and Fumiharu Kato, *Foundations of Rigid Geometry I*,
  arXiv:1308.4734v5, Proposition 0.7.4.16. The relative-annihilator bounds and
  finite-quotient scope generalize its separation and closedness consequences.
* Andrew Yang's formalization of the Noetherian Krull intersection theorem in
  `Mathlib.RingTheory.Filtration`, especially
  `Ideal.mem_iInf_smul_pow_eq_bot_iff`. The pointwise theorem here replaces its
  Noetherian-ring hypothesis by finite-submodule adic cofinality. The
  old-hypothesis, subtype-witness specialization is in
  `CoherentModules.RingTheory.Filtration`.
* Mathlib's cyclic ideal-action, Jacobson modular-inverse, annihilator and
  quotient-module APIs, including work by Kenny Lau, Devon Tuma,
  Wojciech Nawrocki, Johannes Hölzl, Mario Carneiro, Kevin Buzzard and
  Yury Kudryashov.
-/

@[expose] public section

universe uR uM

namespace Ideal.HasFiniteSubmoduleAdicCofinality

variable {R : Type uR} [CommRing R] {I : Ideal R}
variable {M : Type uM} [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- For a finite module and an ideal satisfying finite-submodule adic cofinality,
an element belongs to every ideal-power multiple if and only if some scalar in
the ideal fixes it. The scalar may depend on the element.

This generalizes Mathlib's Noetherian Krull membership theorem
`Ideal.mem_iInf_smul_pow_eq_bot_iff`, formalized by Andrew Yang. The cyclic
argument is the separation argument of Fujiwara--Kato, *Foundations of Rigid
Geometry I*, Proposition 0.7.4.16. -/
theorem mem_iInf_pow_smul_top_iff
    (hAPf : I.HasFiniteSubmoduleAdicCofinality) (x : M) :
    (x ∈ ⨅ n : ℕ, (I ^ n) • (⊤ : Submodule R M)) ↔
      ∃ a ∈ I, a • x = x := by
  constructor
  · intro hx
    obtain ⟨n, hn⟩ := hAPf.cofinal (Submodule.span R ({x} : Set M))
      (Submodule.fg_span_singleton x) 1
    apply Submodule.mem_smul_span_singleton.mp
    simpa only [pow_one] using
      hn ⟨Submodule.mem_span_singleton_self x, (Submodule.mem_iInf _).mp hx n⟩
  · rintro ⟨a, ha, hax⟩
    refine (Submodule.mem_iInf _).mpr fun n => ?_
    have hpow : a ^ n • x = x := by
      induction n with
      | zero => simp only [pow_zero, one_smul]
      | succ n ih => rw [pow_succ, mul_smul, hax, ih]
    exact hpow ▸ Submodule.smul_mem_smul (Ideal.pow_mem_pow ha n) Submodule.mem_top

/-- Finite-submodule adic cofinality separates a finite module when the ideal is
contained in the Jacobson radical of its annihilator. This relative form of the
separation consequence of Fujiwara--Kato, *Foundations of Rigid Geometry I*,
Proposition 0.7.4.16 does not require a faithful action or separation of the ring. -/
theorem iInf_pow_smul_top_eq_bot_of_le_jacobson_annihilator
    (hAPf : I.HasFiniteSubmoduleAdicCofinality)
    (hJ : I ≤ (Module.annihilator R M).jacobson) :
    (⨅ n : ℕ, (I ^ n) • (⊤ : Submodule R M)) = ⊥ := by
  refine eq_bot_iff.mpr ?_
  intro x hx
  apply (Submodule.mem_bot R).mpr
  obtain ⟨a, ha, hax⟩ := (hAPf.mem_iInf_pow_smul_top_iff x).mp hx
  have hsub : (1 - a) • x = 0 := by
    rw [sub_smul, one_smul, hax, sub_self]
  have hj : (1 - a) - 1 ∈ (Module.annihilator R M).jacobson := by
    simpa using hJ ha
  obtain ⟨s, hs⟩ := Ideal.exists_mul_sub_mem_of_sub_one_mem_jacobson (1 - a) hj
  have hkill := Module.mem_annihilator.mp hs x
  have hneg : -x = 0 := by
    simpa only [sub_smul, mul_smul, hsub, smul_zero, one_smul, zero_sub] using hkill
  exact neg_eq_zero.mp hneg

end Ideal.HasFiniteSubmoduleAdicCofinality

namespace Submodule

/-- The preimage of the intersection of ideal-power multiples in a quotient is
the intersection of their sums with the kernel. This uses the ordinary quotient
action and requires no finiteness or cofinality hypothesis. -/
theorem comap_mkQ_iInf_pow_smul_top
    {R : Type uR} [Ring R] {M : Type uM} [AddCommGroup M] [Module R M]
    (N : Submodule R M) (I : Ideal R) :
    (⨅ n : ℕ, (I ^ n) • (⊤ : Submodule R (M ⧸ N))).comap N.mkQ =
      ⨅ n : ℕ, N ⊔ (I ^ n) • (⊤ : Submodule R M) := by
  rw [Submodule.comap_iInf]
  apply iInf_congr
  intro n
  rw [Submodule.comap_smul_top_of_surjective _ N.mkQ N.mkQ_surjective,
    Submodule.ker_mkQ, sup_comm]

variable {R : Type uR} [CommRing R] {I : Ideal R}
variable {M : Type uM} [AddCommGroup M] [Module R M]

/-- For an ideal satisfying finite-submodule adic cofinality, membership in the
intersection of the sums of `N` with the ideal-power multiples is detected by a
scalar in the ideal. Only the quotient must be finite; the ambient module and
`N` need not be finite.

This is a finite-quotient generalization of the algebraic closedness argument in
Fujiwara--Kato, *Foundations of Rigid Geometry I*, Proposition 0.7.4.16. -/
theorem mem_iInf_sup_pow_smul_top_iff_of_hasFiniteSubmoduleAdicCofinality
    (N : Submodule R M) [Module.Finite R (M ⧸ N)]
    (hAPf : I.HasFiniteSubmoduleAdicCofinality) (x : M) :
    (x ∈ ⨅ n : ℕ, N ⊔ (I ^ n) • (⊤ : Submodule R M)) ↔
      ∃ a ∈ I, (1 - a) • x ∈ N := by
  have hmem :
      (x ∈ ⨅ n : ℕ, N ⊔ (I ^ n) • (⊤ : Submodule R M)) ↔
        (N.mkQ x ∈ ⨅ n : ℕ, (I ^ n) • (⊤ : Submodule R (M ⧸ N))) := by
    rw [← N.comap_mkQ_iInf_pow_smul_top I, Submodule.mem_comap]
  refine hmem.trans ((hAPf.mem_iInf_pow_smul_top_iff (N.mkQ x)).trans ?_)
  refine exists_congr fun a => and_congr_right fun _ => ?_
  rw [← Submodule.Quotient.mk_eq_zero N]
  change (a • N.mkQ x = N.mkQ x) ↔ N.mkQ ((1 - a) • x) = 0
  rw [map_smul, sub_smul, one_smul, sub_eq_zero]
  exact eq_comm

/-- Under finite-submodule adic cofinality and a Jacobson bound relative to the
annihilator of the finite quotient, intersecting the sums of a submodule with all
ideal-power multiples recovers the submodule. There is no finiteness assumption
on the ambient module or the submodule.

This generalizes the algebraic closedness consequence of Fujiwara--Kato,
*Foundations of Rigid Geometry I*, Proposition 0.7.4.16. -/
theorem iInf_sup_pow_smul_top_eq_self_of_le_jacobson_annihilator_quotient
    (N : Submodule R M) [Module.Finite R (M ⧸ N)]
    (hAPf : I.HasFiniteSubmoduleAdicCofinality)
    (hJ : I ≤ (Module.annihilator R (M ⧸ N)).jacobson) :
    (⨅ n : ℕ, N ⊔ (I ^ n) • (⊤ : Submodule R M)) = N := by
  rw [← N.comap_mkQ_iInf_pow_smul_top I,
    hAPf.iInf_pow_smul_top_eq_bot_of_le_jacobson_annihilator hJ,
    Submodule.comap_bot, Submodule.ker_mkQ]

/-- In a finite module, the relative Jacobson bound for the ambient annihilator
recovers every submodule by intersecting its sums with the ideal-power
multiples. The submodule need not be finitely generated. -/
theorem iInf_sup_pow_smul_top_eq_self_of_le_jacobson_annihilator
    [Module.Finite R M] (N : Submodule R M)
    (hAPf : I.HasFiniteSubmoduleAdicCofinality)
    (hJ : I ≤ (Module.annihilator R M).jacobson) :
    (⨅ n : ℕ, N ⊔ (I ^ n) • (⊤ : Submodule R M)) = N := by
  let : Module.Finite R (M ⧸ N) :=
    Module.Finite.of_surjective N.mkQ N.mkQ_surjective
  have hJ' : I ≤ (Module.annihilator R (M ⧸ N)).jacobson :=
    hJ.trans (Ideal.jacobson_mono
      (N.mkQ.annihilator_le_of_surjective N.mkQ_surjective))
  exact iInf_sup_pow_smul_top_eq_self_of_le_jacobson_annihilator_quotient
    (R := R) (M := M) (I := I) N hAPf hJ'

private theorem exists_fg_le_and_le_sup_smul (N : Submodule R M)
    (hQ : Module.Finite R (N ⧸ (I • (⊤ : Submodule R N)))) :
    ∃ L : Submodule R M, L.FG ∧ L ≤ N ∧ N ≤ L ⊔ I • N := by
  classical
  let Q : Submodule R N := I • ⊤
  let : Module.Finite R (N ⧸ Q) := hQ
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := N ⧸ Q)
  choose t ht using fun i : Fin n => Q.mkQ_surjective (s i)
  let K : Submodule R N := span R (Set.range t)
  have hK : K.FG := fg_span (Set.finite_range t)
  have hmap : K.map Q.mkQ = ⊤ := by
    have ht' : Q.mkQ ∘ t = s := funext ht
    simpa only [K, map_span, ← Set.range_comp, ht'] using hs
  have htop : K ⊔ Q = ⊤ := by
    rw [sup_comm]
    exact (Q.map_mkQ_eq_top K).mp hmap
  refine ⟨K.map N.subtype, hK.map _, N.map_subtype_le K, ?_⟩
  have h := congrArg (Submodule.map N.subtype) htop
  simpa only [Q, map_sup, map_smul'', map_subtype_top] using h.ge

/-- Under finite-submodule adic cofinality and the Jacobson bound relative to the
ambient annihilator, a submodule of a finite module is finitely generated when
its intrinsic first adic quotient is finite over the original ring.

This follows from the relative Krull intersection consequence of
Fujiwara--Kato, *Foundations of Rigid Geometry I*, Proposition 0.7.4.16. -/
theorem fg_of_finite_quotient_smul
    [Module.Finite R M] (N : Submodule R M)
    (hAPf : I.HasFiniteSubmoduleAdicCofinality)
    (hJ : I ≤ (Module.annihilator R M).jacobson)
    (hQ : Module.Finite R (N ⧸ (I • (⊤ : Submodule R N)))) :
    N.FG := by
  obtain ⟨L, hLfg, hLN, hstep⟩ := exists_fg_le_and_le_sup_smul (I := I) N hQ
  have hpow : ∀ n : ℕ, N ≤ L ⊔ (I ^ n) • (⊤ : Submodule R M) := fun n =>
    (le_sup_pow_smul_of_le_sup_smul hstep n).trans
      (sup_le_sup le_rfl (Submodule.smul_mono le_rfl le_top))
  have hNL : N ≤ L := by
    rw [← iInf_sup_pow_smul_top_eq_self_of_le_jacobson_annihilator (I := I) L hAPf hJ]
    exact le_iInf hpow
  rw [le_antisymm hNL hLN]
  exact hLfg

/-- Finite generation of a submodule of a finite module is detected on its
intrinsic first adic quotient, under finite-submodule adic cofinality and the
Jacobson bound relative to the ambient annihilator. -/
theorem fg_iff_finite_quotient_smul
    [Module.Finite R M] (N : Submodule R M)
    (hAPf : I.HasFiniteSubmoduleAdicCofinality)
    (hJ : I ≤ (Module.annihilator R M).jacobson) :
    N.FG ↔ Module.Finite R (N ⧸ (I • (⊤ : Submodule R N))) := by
  constructor
  · intro hN
    let : Module.Finite R N := Module.Finite.of_fg hN
    infer_instance
  · exact fg_of_finite_quotient_smul (I := I) N hAPf hJ

end Submodule
