module

public import CoherentModules.Basic
public import Mathlib.LinearAlgebra.BilinearMap
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Basic

/-!
# Coherence of annihilator quotients

Suppose a ring `A` and a semiring `C` act on the same additive commutative group
`M`, and the given actions commute. Finite generation over `C` and coherence
over `A` imply that `A` modulo the annihilator of its given action is a coherent
ring. The scalar types and module carrier have independent universes. Neither
scalar type needs to be Noetherian, and the `A`-action need not commute with itself.

The cyclic `A`-submodule generated by the identity in the `C`-linear
endomorphisms embeds, by evaluation at finitely many generators, into a finite
product of copies of `M`. It is therefore coherent over `A`. Its identification
with the annihilator quotient gives coherence over `A`, and
`Module.IsCoherent.of_restrictScalars` gives coherence over the quotient ring.
No coherence of the whole endomorphism module is needed.

## References

The scalar representation and its kernel calculation follow the
annihilator-quotient argument in `CoherentModules.RingTheory.Noetherian`.
The proof uses Mathlib's pointwise linear-map actions, generator
extensionality, first isomorphism theorem and quotient-ring scalar tower,
together with this library's coherent-submodule and finite-product results.
-/

@[expose] public section

universe uA uC uM

/-- If `M` is coherent over a ring `A` and finitely generated over a semiring `C`
whose given action commutes with the given `A`-action, then `A` modulo the annihilator
of its original action is a coherent ring. No Noetherianity assumption on `A` or `C`
is required. -/
theorem isCoherentRing_quotient_annihilator_of_finite
    {A : Type uA} {C : Type uC} {M : Type uM}
    [Ring A] [Semiring C] [AddCommGroup M]
    [Module A M] [Module C M] [SMulCommClass A C M]
    [Module.Finite C M] [Module.IsCoherent A M] :
    IsCoherentRing (A ⧸ Module.annihilator A M) := by
  let : SMulCommClass C A M := SMulCommClass.symm A C M
  let I : Ideal A := Module.annihilator A M
  let Q := A ⧸ I
  let E := M →ₗ[C] M
  let f : A →ₗ[A] E := LinearMap.toSpanSingleton A E (LinearMap.id : E)
  let J : Submodule A E := LinearMap.range f
  let : Module.Finite A J := Module.Finite.range f
  obtain ⟨n, v, hv⟩ := Module.Finite.exists_fin (R := C) (M := M)
  let ev : E →ₗ[A] (Fin n → M) :=
    LinearMap.pi fun i ↦
      (LinearMap.flip (LinearMap.id : (M →ₗ[C] M) →ₗ[A] (M →ₗ[C] M))) (v i)
  have hev : Function.Injective ev := by
    intro h k hh
    exact LinearMap.ext_on_range hv fun i ↦ congrFun hh i
  let evJ : J →ₗ[A] (Fin n → M) := ev.comp J.subtype
  have hinj : Function.Injective evJ := hev.comp (Submodule.injective_subtype J)
  let : Module.IsCoherent A (Fin n → M) := inferInstance
  let : Module.IsCoherent A (LinearMap.range evJ) := Module.IsCoherent.range evJ
  let d : J ≃ₗ[A] LinearMap.range evJ := LinearEquiv.ofInjective evJ hinj
  let : Module.IsCoherent A J := Module.IsCoherent.of_equiv d.symm
  have hker : LinearMap.ker f = (I : Submodule A A) := by
    ext a
    constructor
    · intro ha
      apply Module.mem_annihilator.mpr
      intro m
      exact LinearMap.congr_fun (LinearMap.mem_ker.mp ha) m
    · intro ha
      apply LinearMap.mem_ker.mpr
      ext m
      exact (Module.mem_annihilator.mp ha) m
  let e : Q ≃ₗ[A] J :=
    (Submodule.quotEquivOfEq (I : Submodule A A) (LinearMap.ker f) hker.symm).trans
      f.quotKerEquivRange
  let : Module.IsCoherent A Q := Module.IsCoherent.of_equiv e.symm
  exact ⟨Module.IsCoherent.of_restrictScalars A (S := Q) (N := Q)⟩
