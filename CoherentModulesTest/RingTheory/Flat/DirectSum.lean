/-!
# Direct-sum projections and faithfully flat examples

Coordinate projections split the canonical inclusions for an arbitrary dependent
family of modules. These maps and tensor-distribution equivalences are evaluated
on included elements, and the tensor/quotient equivalence is evaluated on their
quotient classes.

The countable direct sum of integer scalar modules is faithfully flat and not
finitely generated. Its faithful flatness follows from the coordinate projection
onto the integers. The empty direct sum is flat but not faithfully flat over the
integers; over the trivial ring `ZMod 1`, the empty direct sum is faithfully flat.

The ideals generated by three and four in `ZMod 6` give a family with different
carriers. Both are projective and flat. Their direct sum is faithfully flat via
the canonical addition map, although neither ideal is faithfully flat: each is
a proper ideal acting as the identity on itself.

The direct-sum criterion extracts joint proper-ideal detection from this example.
The chosen-component constructor gives the countable integer sum, and choosing
any component recovers faithful flatness of a nonempty sum of faithfully flat
modules. The converse criterion also constructs the empty sum over `ZMod 1`,
using the absence of proper ideals rather than a nonempty index type.

## References

The examples use Mathlib's direct-sum, Finsupp, tensor/quotient, complementary
submodule projection, projective splitting, flatness and faithful-flatness APIs.
They reuse `Module.FaithfullyFlat.of_surjective` and the public empty-Finsupp
boundary in `CoherentModulesTest.Flat.TensorProduct.integerScalarEmptyBoundary`.
The complementary principal-ideal model follows the examples in
[AlgebraicGroups](https://github.com/FormalFrontier/algebraic-groups), especially
`AlgebraicGroupsTest/Algebra/Coalgebra/IdempotentIdeal.lean` and
`AlgebraicGroupsTest/Algebra/Coalgebra/IdempotentIdealTensor.lean`. The arguments
here use only the module structures on the ideals, not coalgebra structures or
an AlgebraicGroups dependency.
-/

open scoped DirectSum TensorProduct

noncomputable section

namespace CoherentModulesTest.Flat.DirectSum

universe u v w t

section Coordinates

variable {R : Type u} [CommRing R]
variable {ι : Type v} {M : ι → Type w}
variable [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]

example [DecidableEq ι] (i : ι) (x : M i) :
    DirectSum.component R ι M i (DirectSum.lof R ι M i x) = x := by
  exact DirectSum.component.lof_self R i x

example [DecidableEq ι] (i j : ι) (x : M j) :
    DirectSum.component R ι M i (DirectSum.lof R ι M j x) =
      if h : j = i then Eq.recOn h x else 0 := by
  exact DirectSum.component.of R i j x

example (i : ι) : Function.Surjective (DirectSum.component R ι M i) := by
  classical
  exact fun x ↦ ⟨DirectSum.lof R ι M i x, DirectSum.component.lof_self R i x⟩

example [∀ i, Module.Flat R (M i)] (i : ι)
    [Module.FaithfullyFlat R (M i)] : Module.FaithfullyFlat R (⨁ i, M i) := by
  classical
  exact Module.FaithfullyFlat.of_surjective (DirectSum.component R ι M i)
    (fun x ↦ ⟨DirectSum.lof R ι M i x, DirectSum.component.lof_self R i x⟩)

example [DecidableEq ι] {N : Type t} [AddCommGroup N] [Module R N]
    (i : ι) (x : M i) (y : N) :
    TensorProduct.directSumLeft R R M N
        (DirectSum.lof R ι M i x ⊗ₜ[R] y) =
      DirectSum.lof R ι (fun i ↦ M i ⊗[R] N) i (x ⊗ₜ[R] y) := by
  exact TensorProduct.directSumLeft_tmul_lof R R i x y

example [DecidableEq ι] {N : Type t} [AddCommGroup N] [Module R N]
    (d : ⨁ i, M i) (y : N) (i : ι) :
    DirectSum.component R ι (fun i ↦ M i ⊗[R] N) i
        (TensorProduct.directSumLeft R R M N (d ⊗ₜ[R] y)) =
      DirectSum.component R ι M i d ⊗ₜ[R] y := by
  exact TensorProduct.directSumLeft_tmul R R d y i

example [DecidableEq ι] (I : Ideal R) (i : ι) (x : M i) :
    TensorProduct.quotTensorEquivQuotSMul (⨁ i, M i) I
        ((1 : R ⧸ I) ⊗ₜ[R] DirectSum.lof R ι M i x) =
      Submodule.Quotient.mk (DirectSum.lof R ι M i x) := by
  exact TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul I _

end Coordinates

/-- The countable direct sum of integer scalar modules is faithfully flat and not
finitely generated; its zeroth coordinate projection is surjective. -/
public theorem integerCountableDirectSum :
    Module.Flat ℤ (⨁ _ : ℕ, ℤ) ∧
      Function.Surjective (DirectSum.component ℤ ℕ (fun _ ↦ ℤ) 0) ∧
      Module.FaithfullyFlat ℤ (⨁ _ : ℕ, ℤ) ∧
      ¬ Module.Finite ℤ (⨁ _ : ℕ, ℤ) := by
  classical
  have hsurj : Function.Surjective
      (DirectSum.component ℤ ℕ (fun _ ↦ ℤ) 0) :=
    fun z ↦ ⟨DirectSum.lof ℤ ℕ (fun _ ↦ ℤ) 0 z,
      DirectSum.component.lof_self ℤ (M := fun _ : ℕ ↦ ℤ) 0 z⟩
  refine ⟨inferInstance, hsurj,
    Module.FaithfullyFlat.of_surjective
      (DirectSum.component ℤ ℕ (fun _ ↦ ℤ) 0) hsurj, ?_⟩
  intro h
  let : Module.Finite ℤ (⨁ _ : ℕ, ℤ) := h
  have hf : Module.Finite ℤ (ℕ →₀ ℤ) :=
    Module.Finite.equiv (finsuppLEquivDirectSum ℤ ℤ ℕ).symm
  exact Module.not_finite_of_infinite_basis
    (Finsupp.basisSingleOne : Module.Basis ℕ ℤ (ℕ →₀ ℤ)) hf

example (i : ℕ) (z : ℤ) :
    DirectSum.component ℤ ℕ (fun _ ↦ ℤ) i
        (DirectSum.lof ℤ ℕ (fun _ ↦ ℤ) i z) = z := by
  simp

example (i : ℕ) (z : ℤ) :
    (finsuppLEquivDirectSum ℤ ℤ ℕ).symm
        (DirectSum.lof ℤ ℕ (fun _ ↦ ℤ) i z) = Finsupp.single i z := by
  simp

/-- The empty direct sum is flat but not faithfully flat over the integers. -/
public theorem integerEmptyDirectSum :
    Module.Flat ℤ (⨁ _ : Fin 0, ℤ) ∧
      ¬ Module.FaithfullyFlat ℤ (⨁ _ : Fin 0, ℤ) := by
  classical
  refine ⟨inferInstance, ?_⟩
  intro h
  let : Module.FaithfullyFlat ℤ (⨁ _ : Fin 0, ℤ) := h
  exact CoherentModulesTest.Flat.TensorProduct.integerScalarEmptyBoundary.2.2.2.1
    (Module.FaithfullyFlat.of_linearEquiv ℤ (⨁ _ : Fin 0, ℤ)
      (finsuppLEquivDirectSum ℤ ℤ (Fin 0)))

/-- Over the trivial scalar ring, the empty direct sum is faithfully flat. -/
public theorem trivialScalarEmptyDirectSum :
    Module.FaithfullyFlat (ZMod 1) (⨁ _ : Fin 0, ZMod 1) := by
  let : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
  exact Module.FaithfullyFlat.of_linearEquiv (ZMod 1) (ZMod 1)
    (LinearEquiv.ofSubsingleton (⨁ _ : Fin 0, ZMod 1) (ZMod 1))

example {N : Type t} [AddCommGroup N] [Module (ZMod 1) N] : Subsingleton N := by
  let : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
  exact Module.subsingleton (ZMod 1) N

section ComplementaryIdeals

private abbrev K := ZMod 6
private abbrev I3 : Ideal K := Ideal.span ({3} : Set K)
private abbrev I4 : Ideal K := Ideal.span ({4} : Set K)
private abbrev J (i : Fin 2) : Ideal K := if i = 0 then I3 else I4
private abbrev M (i : Fin 2) := ↥(J i)

private theorem three_mul_three : (3 : K) * 3 = 3 := by decide
private theorem four_mul_four : (4 : K) * 4 = 4 := by decide
private theorem three_mul_four : (3 : K) * 4 = 0 := by decide
private theorem three_add_four : (3 : K) + 4 = 1 := by decide
private theorem three_ne_zero : (3 : K) ≠ 0 := by decide
private theorem four_ne_zero : (4 : K) ≠ 0 := by decide

private theorem three_smul_self (x : I3) : (3 : K) • x = x := by
  apply Subtype.ext
  change (3 : K) * (x : K) = (x : K)
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp x.property
  rw [← ha, mul_left_comm (3 : K) a 3, three_mul_three]

private theorem four_smul_self (x : I4) : (4 : K) • x = x := by
  apply Subtype.ext
  change (4 : K) * (x : K) = (x : K)
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp x.property
  rw [← ha, mul_left_comm (4 : K) a 4, four_mul_four]

private theorem complementary : IsCompl I3 I4 := by
  constructor
  · rw [disjoint_iff_inf_le]
    intro x hx
    have hself : (3 : K) * x = x := by
      have h := congrArg (fun y : I3 ↦ (y : K)) (three_smul_self ⟨x, hx.1⟩)
      exact h
    have hzero : (3 : K) * x = 0 := by
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hx.2
      rw [← ha, mul_left_comm (3 : K) a 4, three_mul_four, mul_zero]
    change x = 0
    exact hself.symm.trans hzero
  · apply codisjoint_iff.mpr
    apply (Ideal.eq_top_iff_one _).mpr
    rw [← three_add_four]
    exact Submodule.add_mem_sup
      (Ideal.mem_span_singleton_self 3) (Ideal.mem_span_singleton_self 4)

private theorem three_proper : I3 ≠ ⊤ := by
  intro h
  have hzero : I4 = ⊥ := by
    simpa only [h, top_inf_eq] using complementary.inf_eq_bot
  have hmem : (4 : K) ∈ I4 := Ideal.mem_span_singleton_self 4
  rw [hzero] at hmem
  exact four_ne_zero (by simpa only [Submodule.mem_bot] using hmem)

private theorem four_proper : I4 ≠ ⊤ := by
  intro h
  have hzero : I3 = ⊥ := by
    simpa only [h, inf_top_eq] using complementary.inf_eq_bot
  have hmem : (3 : K) ∈ I3 := Ideal.mem_span_singleton_self 3
  rw [hzero] at hmem
  exact three_ne_zero (by simpa only [Submodule.mem_bot] using hmem)

private theorem three_projective : Module.Projective K I3 :=
  Module.Projective.of_split I3.subtype (I3.projectionOnto I4 complementary)
    (Submodule.projectionOnto_comp_subtype complementary)

private theorem four_projective : Module.Projective K I4 :=
  Module.Projective.of_split I4.subtype (I4.projectionOnto I3 complementary.symm)
    (Submodule.projectionOnto_comp_subtype complementary.symm)

private theorem summand_projective (i : Fin 2) : Module.Projective K (M i) := by
  -- Concrete indices reduce both the carriers and their canonical module structures.
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · exact three_projective
  · refine Fin.cases ?_ (fun k ↦ Fin.elim0 k) j
    exact four_projective

private theorem summand_flat (i : Fin 2) : Module.Flat K (M i) := by
  let : Module.Projective K (M i) := summand_projective i
  infer_instance

private theorem three_not_faithfullyFlat : ¬ Module.FaithfullyFlat K I3 := by
  intro h
  have htop : I3 • (⊤ : Submodule K I3) = ⊤ := by
    apply top_unique
    intro x _
    rw [← three_smul_self x]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self 3)
      (Submodule.mem_top : x ∈ (⊤ : Submodule K I3))
  exact three_proper
    (((Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top K I3).mp h).2 I3 htop)

private theorem four_not_faithfullyFlat : ¬ Module.FaithfullyFlat K I4 := by
  intro h
  have htop : I4 • (⊤ : Submodule K I4) = ⊤ := by
    apply top_unique
    intro x _
    rw [← four_smul_self x]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self 4)
      (Submodule.mem_top : x ∈ (⊤ : Submodule K I4))
  exact four_proper
    (((Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top K I4).mp h).2 I4 htop)

private def addition : (⨁ i : Fin 2, M i) →ₗ[K] K :=
  DirectSum.toModule K (Fin 2) K (fun i ↦ (J i).subtype)

private theorem addition_lof (i : Fin 2) (x : M i) :
    addition (DirectSum.lof K (Fin 2) M i x) = (x : K) := by
  exact DirectSum.toModule_lof K (ι := Fin 2) (M := M) (N := K)
    (φ := fun j ↦ (J j).subtype) i x

private theorem addition_pair (x : M 0) (y : M 1) :
    addition (DirectSum.lof K (Fin 2) M 0 x + DirectSum.lof K (Fin 2) M 1 y) =
      (x : K) + (y : K) := by
  rw [map_add, addition_lof, addition_lof]

private theorem addition_surjective : Function.Surjective addition := by
  let g3 : M 0 := ⟨3, Ideal.mem_span_singleton_self 3⟩
  let g4 : M 1 := ⟨4, Ideal.mem_span_singleton_self 4⟩
  intro r
  refine ⟨DirectSum.lof K (Fin 2) M 0 (r • g3) +
    DirectSum.lof K (Fin 2) M 1 (r • g4), ?_⟩
  rw [addition_pair]
  change r * 3 + r * 4 = r
  rw [← mul_add, three_add_four, mul_one]

private theorem sum_faithfullyFlat : Module.FaithfullyFlat K (⨁ i : Fin 2, M i) := by
  let : ∀ i, Module.Flat K (M i) := summand_flat
  exact Module.FaithfullyFlat.of_surjective addition addition_surjective

/-- The two complementary principal ideals of `ZMod 6` are flat, their dependent
direct sum is faithfully flat, and neither summand is faithfully flat. -/
public theorem zmodSixComplementaryDirectSum :
    (∀ i : Fin 2, Module.Flat (ZMod 6)
      ↥(if i = 0 then Ideal.span ({3} : Set (ZMod 6))
        else Ideal.span ({4} : Set (ZMod 6)))) ∧
      Module.FaithfullyFlat (ZMod 6)
        (⨁ i : Fin 2, ↥(if i = 0 then Ideal.span ({3} : Set (ZMod 6))
          else Ideal.span ({4} : Set (ZMod 6)))) ∧
      ¬ Module.FaithfullyFlat (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))) ∧
      ¬ Module.FaithfullyFlat (ZMod 6) (Ideal.span ({4} : Set (ZMod 6))) := by
  exact ⟨summand_flat, sum_faithfullyFlat,
    three_not_faithfullyFlat, four_not_faithfullyFlat⟩

/-- Both complementary principal ideals are projective and finitely generated. -/
public theorem zmodSixComplementaryProjectiveFinite :
    Module.Projective (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))) ∧
      Module.Projective (ZMod 6) (Ideal.span ({4} : Set (ZMod 6))) ∧
      Module.Finite (ZMod 6) (Ideal.span ({3} : Set (ZMod 6))) ∧
      Module.Finite (ZMod 6) (Ideal.span ({4} : Set (ZMod 6))) := by
  exact ⟨three_projective, four_projective,
    Module.Finite.of_fg (show I3.FG from Submodule.fg_span_singleton (3 : K)),
    Module.Finite.of_fg (show I4.FG from Submodule.fg_span_singleton (4 : K))⟩

private def sumEquivScalar : (⨁ i : Fin 2, M i) ≃ₗ[K] K :=
  (DirectSum.linearEquivFunOnFintype K (Fin 2) M ≪≫ₗ LinearEquiv.piFinTwo K M) ≪≫ₗ
    Submodule.prodEquivOfIsCompl I3 I4 complementary

private theorem sumEquivScalar_apply (d : ⨁ i : Fin 2, M i) :
    sumEquivScalar d = (d 0 : K) + (d 1 : K) := rfl

example (x : M 0) (y : M 1) :
    sumEquivScalar
        (DirectSum.lof K (Fin 2) M 0 x + DirectSum.lof K (Fin 2) M 1 y) =
      (x : K) + (y : K) := by
  simp [sumEquivScalar_apply, DirectSum.lof_eq_of, DirectSum.of_eq_of_ne]

example {N : Type t} [AddCommGroup N] [Module K N]
    (d : ⨁ i : Fin 2, M i) (n : N) :
    (TensorProduct.congr sumEquivScalar (LinearEquiv.refl K N) ≪≫ₗ
        TensorProduct.lid K N) (d ⊗ₜ[K] n) =
      ((d 0 : K) + (d 1 : K)) • n := by
  simp [sumEquivScalar_apply]

example {N : Type t} [AddCommGroup N] [Module K N]
    (h : ∀ i : Fin 2, Subsingleton (M i ⊗[K] N)) : Subsingleton N := by
  let : ∀ i : Fin 2, Subsingleton (M i ⊗[K] N) := h
  let d := TensorProduct.directSumLeft K K M N
  let : Subsingleton ((⨁ i : Fin 2, M i) ⊗[K] N) := d.injective.subsingleton
  let e := TensorProduct.congr sumEquivScalar (LinearEquiv.refl K N) ≪≫ₗ
    TensorProduct.lid K N
  exact e.symm.injective.subsingleton

/-- The complementary ideals of `ZMod 6` jointly detect every proper ideal,
although every summand fails to be faithfully flat. -/
public theorem zmodSixJointProperIdealDetection :
    (∀ i : Fin 2, Module.Flat (ZMod 6)
      ↥(if i = 0 then Ideal.span ({3} : Set (ZMod 6))
        else Ideal.span ({4} : Set (ZMod 6)))) ∧
      (∀ I : Ideal (ZMod 6), I ≠ ⊤ → ∃ i : Fin 2,
        Nontrivial (((ZMod 6) ⧸ I) ⊗[ZMod 6]
          ↥(if i = 0 then Ideal.span ({3} : Set (ZMod 6))
            else Ideal.span ({4} : Set (ZMod 6))))) ∧
      (∀ i : Fin 2, ¬ Module.FaithfullyFlat (ZMod 6)
        ↥(if i = 0 then Ideal.span ({3} : Set (ZMod 6))
          else Ideal.span ({4} : Set (ZMod 6)))) := by
  have h := (Module.FaithfullyFlat.directSum_iff K M).mp sum_faithfullyFlat
  refine ⟨h.1, h.2, ?_⟩
  intro i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · exact three_not_faithfullyFlat
  · refine Fin.cases ?_ (fun k ↦ Fin.elim0 k) j
    exact four_not_faithfullyFlat

end ComplementaryIdeals

section FaithfullyFlatSums

variable {R : Type u} [CommRing R]
variable {ι : Type v} {M : ι → Type w}
variable [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]

example [∀ i, Module.Flat R (M i)] (i : ι)
    [Module.FaithfullyFlat R (M i)] :
    Module.FaithfullyFlat R (⨁ j, M j) ∧
      Function.Surjective (DirectSum.component R ι M i) := by
  classical
  exact ⟨Module.FaithfullyFlat.directSum_of_component M i,
    fun x ↦ ⟨DirectSum.lof R ι M i x,
      DirectSum.component.lof_self R (M := M) i x⟩⟩

/-- A nonempty direct sum of faithfully flat modules is faithfully flat,
by choosing any one of its summands. -/
public theorem faithfullyFlatDirectSumOfSummands
    [Nonempty ι] [∀ i, Module.FaithfullyFlat R (M i)] :
    Module.FaithfullyFlat R (⨁ i, M i) := by
  let : ∀ i, Module.Flat R (M i) := fun _ ↦ inferInstance
  exact Module.FaithfullyFlat.directSum_of_component M (Classical.choice ‹Nonempty ι›)

end FaithfullyFlatSums

/-- Choosing the zeroth scalar component gives a faithfully flat countable
integer sum, which is not finitely generated and projects onto the integers. -/
public theorem integerCountableDirectSumOfComponent :
    Module.FaithfullyFlat ℤ (⨁ _ : ℕ, ℤ) ∧
      ¬ Module.Finite ℤ (⨁ _ : ℕ, ℤ) ∧
      Function.Surjective (DirectSum.component ℤ ℕ (fun _ ↦ ℤ) 0) := by
  exact ⟨Module.FaithfullyFlat.directSum_of_component (fun _ : ℕ ↦ ℤ) 0,
    integerCountableDirectSum.2.2.2, integerCountableDirectSum.2.1⟩

/-- Every ideal of `ZMod 1` is the whole ring, so the proper-ideal criterion
makes its empty direct sum faithfully flat. -/
public theorem trivialScalarEmptyDirectSumOfProperIdeals :
    (∀ I : Ideal (ZMod 1), I = ⊤) ∧
      Module.FaithfullyFlat (ZMod 1) (⨁ _ : Fin 0, ZMod 1) := by
  let : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
  have htop (I : Ideal (ZMod 1)) : I = ⊤ := Subsingleton.elim _ _
  refine ⟨htop,
    (Module.FaithfullyFlat.directSum_iff (ZMod 1) (fun _ : Fin 0 ↦ ZMod 1)).mpr
      ⟨?_, ?_⟩⟩
  · exact fun i ↦ Fin.elim0 i
  · intro I hI
    exact (hI (htop I)).elim

end CoherentModulesTest.Flat.DirectSum
