module

public import CoherentModules.LinearAlgebra.Finsupp.Supported
public import Mathlib.Algebra.Polynomial.Coeff

/-!
# A nonzero proper coordinate face over natural-number polynomials

In the original regular `Polynomial ℕ`-module of finitely supported sequences,
consider the span of `single 0 X` and `single 0 1 + single 1 X`. Its face supported
at zero is the span of the first generator. This face is nonzero and strictly
smaller than the two-generated submodule, although the ambient index type is infinite.
-/

@[expose] public section

namespace Finsupp

/-- The face supported at zero of this two-generated semimodule over `ℕ[X]` is
nonzero and proper, and is generated by exactly its supported generator. -/
theorem polynomial_nat_nonzero_proper_supported_face :
    let u : ℕ →₀ Polynomial ℕ := Finsupp.single 0 Polynomial.X
    let v : ℕ →₀ Polynomial ℕ :=
      Finsupp.single 0 1 + Finsupp.single 1 Polynomial.X
    let K := Submodule.span (Polynomial ℕ) ({u, v} : Set (ℕ →₀ Polynomial ℕ))
    (K ⊓ supported (Polynomial ℕ) (Polynomial ℕ) ({0} : Set ℕ) =
        Submodule.span (Polynomial ℕ) ({u} : Set (ℕ →₀ Polynomial ℕ))) ∧
      (K ⊓ supported (Polynomial ℕ) (Polynomial ℕ) ({0} : Set ℕ) ≠ ⊥) ∧
      (K ⊓ supported (Polynomial ℕ) (Polynomial ℕ) ({0} : Set ℕ) < K) ∧
      K.FG := by
  classical
  dsimp only
  let u : ℕ →₀ Polynomial ℕ := Finsupp.single 0 Polynomial.X
  let v : ℕ →₀ Polynomial ℕ :=
    Finsupp.single 0 1 + Finsupp.single 1 Polynomial.X
  let K := Submodule.span (Polynomial ℕ) ({u, v} : Set (ℕ →₀ Polynomial ℕ))
  let F := supported (Polynomial ℕ) (Polynomial ℕ) ({0} : Set ℕ)
  have hconical : ∀ ⦃p q : Polynomial ℕ⦄, p + q = 0 → p = 0 ∧ q = 0 := by
    intro p q h
    have hc : ∀ n, p.coeff n = 0 ∧ q.coeff n = 0 := by
      intro n
      apply Nat.add_eq_zero_iff.mp
      simpa only [Polynomial.coeff_add, Polynomial.coeff_zero] using
        congrArg (fun t : Polynomial ℕ => t.coeff n) h
    exact ⟨Polynomial.ext fun n => by simpa only [Polynomial.coeff_zero] using (hc n).1,
      Polynomial.ext fun n => by simpa only [Polynomial.coeff_zero] using (hc n).2⟩
  have hu : u ∈ F := single_mem_supported (Polynomial ℕ) Polynomial.X (by simp)
  have hv : v ∉ F := by
    intro h
    have h1 := (mem_supported' (Polynomial ℕ) v).mp h 1 (by simp)
    simp [v] at h1
  have hu0 : u ≠ 0 := by
    intro h
    have h0 := congrArg (fun p : ℕ →₀ Polynomial ℕ => p 0) h
    simp [u] at h0
  have hfilter : ({u, v} : Set (ℕ →₀ Polynomial ℕ)) ∩ (F : Set (ℕ →₀ Polynomial ℕ)) =
      {u} := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_insert_iff, Set.mem_singleton_iff, SetLike.mem_coe]
    constructor
    · rintro ⟨rfl | rfl, hx⟩
      · rfl
      · exact (hv hx).elim
    · rintro rfl
      exact ⟨Or.inl rfl, hu⟩
  have hface : K ⊓ F = Submodule.span (Polynomial ℕ) ({u} : Set (ℕ →₀ Polynomial ℕ)) := by
    calc
      K ⊓ F = Submodule.span (Polynomial ℕ)
          (({u, v} : Set (ℕ →₀ Polynomial ℕ)) ∩ (F : Set (ℕ →₀ Polynomial ℕ))) :=
        span_inf_supported_eq_span_inter_self ({0} : Set ℕ) {u, v} hconical
      _ = _ := congrArg (Submodule.span (Polynomial ℕ)) hfilter
  have huK : u ∈ K := Submodule.subset_span (by simp)
  have hvK : v ∈ K := Submodule.subset_span (by simp)
  refine ⟨hface, ?_, ?_, Submodule.fg_span (Set.Finite.insert u (Set.finite_singleton v))⟩
  · intro hbot
    have hmem : u ∈ (⊥ : Submodule (Polynomial ℕ) (ℕ →₀ Polynomial ℕ)) :=
      hbot ▸ (show u ∈ K ⊓ F from ⟨huK, hu⟩)
    exact hu0 ((Submodule.mem_bot (Polynomial ℕ)).mp hmem)
  · exact lt_iff_le_not_ge.mpr ⟨inf_le_left, fun hle => hv (hle hvK).2⟩

end Finsupp
